    "#\"magic command\" pour avoir des figures dynamiques et animées dans le notebook :\n",
    "%matplotlib notebook\n",
    "%matplotlib inline\n",
    "\n",
    "import time\n",
    "import numpy as np\n",
    "import scipy.linalg\n",
    "import scipy.optimize\n",
    "import matplotlib.pyplot as plt\n",
    "import matplotlib.animation as animation\n",
    "import matplotlib.cm as cm"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 156,
   "metadata": {
    "slideshow": {
     "slide_type": "skip"
    }
   },
   "outputs": [],
   "source": [
    "def tabtemps(param) :\n",
    "    param.t = np.linspace(0, param.T, param.n + 1)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 157,
   "metadata": {
    "slideshow": {
     "slide_type": "skip"
    }
   },
   "outputs": [],
   "source": [
    "# maintenant f(U(t)) = A. U(t)\n",
    "def linear(u, param) :\n",
    "    f_u = np.dot(param.A, u) # np.dot() : produit matrice/vecteur en python\n",
    "    return f_u"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 158,
   "metadata": {
    "slideshow": {
     "slide_type": "skip"
    }
   },
   "outputs": [],
   "source": [
    "# Calcul de la solution linéaire exacte U_ex quand le \n",
    "# \"coefficient\" est une matrice de dimension égale \n",
    "# à l'ordre de l'EDO (i.e. U_ex = U0 . expm(t*A))\n",
    "def exp_mat(t, param) :\n",
    "    # On utilise la fonction scipy.linalg.expm pour le calcul de l'exponentielle de matrice\n",
    "    U_ex = np.dot(scipy.linalg.expm(t * param.A), param.u0)\n",
    "    return U_ex"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 159,
   "metadata": {
    "slideshow": {
     "slide_type": "skip"
    }
   },
   "outputs": [],
   "source": [
    "# Mise à jour de l'attribut param.solution_exacte pour tous les temps t (param.t)\n",
    "def calcul_solution_exacte(param) :\n",
    "    param.solution_exacte = np.zeros([param.n + 1, param.dd])\n",
    "    for i in range (0, param.n + 1) : \n",
    "        param.solution_exacte[i,:] = exp_mat(param.t[i], param)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 160,
   "metadata": {
    "slideshow": {
     "slide_type": "skip"
    }
   },
   "outputs": [],
   "source": [
    "def euler_explicite(param) :\n",
    "    '''\n",
    "    Schema d'Euler explicite valable \n",
    "    pour des EDO d'ordre >= 1\n",
    "    '''\n",
    "    u0 = param.u0\n",
    "    dt = param.dt\n",
    "    n = param.n\n",
    "    dd = param.dd\n",
    "    \n",
    "    u = np.zeros((n + 1, dd))\n",
    "    u[0,:] = u0\n",
    "    for i in range(0, n) :\n",
    "        u[i+1,:] = u[i,:] + dt * param.function(u[i,:], param) \n",
    "    param.solution_approchee = u"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 161,
   "metadata": {
    "slideshow": {
     "slide_type": "skip"
    }
   },
   "outputs": [],
   "source": [
    "def fonct_implicite(u_np1, u_n): # necessaire pour le schema d Euler implicite  \n",
    "    g_u = param.function(u_np1, param) - (u_np1 - u_n) / param.dt\n",
    "    return g_u"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 162,
   "metadata": {
    "slideshow": {
     "slide_type": "skip"
    }
   },
   "outputs": [],
